{
  "name": "native-reader-workspace",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "typecheck": "pnpm --filter @hamster-note/native-reader typecheck && pnpm --filter @hamster-note/native-reader-demo typecheck",
    "lint": "pnpm exec eslint . --no-error-on-unmatched-pattern && pnpm --filter @hamster-note/native-reader lint && pnpm --filter @hamster-note/native-reader-demo lint",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "test": "pnpm --filter @hamster-note/native-reader test && pnpm --filter @hamster-note/native-reader-demo test",
    "build": "pnpm --filter @hamster-note/native-reader build:verify && pnpm --filter @hamster-note/native-reader-demo build:web",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "10.0.1",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
