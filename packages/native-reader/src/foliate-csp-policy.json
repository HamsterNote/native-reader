{
  "schemaVersion": 1,
  "directiveOrder": [
    "default-src",
    "script-src",
    "style-src",
    "img-src",
    "font-src",
    "media-src",
    "frame-src",
    "worker-src",
    "connect-src",
    "object-src",
    "form-action",
    "base-uri"
  ],
  "policies": {
    "host": {
      "version": "foliate-host-csp-1",
      "directives": {
        "default-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "blob:", "'unsafe-inline'"],
        "img-src": ["'self'", "blob:", "data:"],
        "font-src": ["'self'", "blob:", "data:"],
        "media-src": ["'self'", "blob:", "data:"],
        "frame-src": ["blob:"],
        "worker-src": ["'none'"],
        "connect-src": ["'none'"],
        "object-src": ["'none'"],
        "form-action": ["'none'"],
        "base-uri": ["'none'"]
      }
    },
    "publication": {
      "version": "foliate-publication-csp-1",
      "directives": {
        "default-src": ["'none'"],
        "script-src": ["'none'"],
        "style-src": ["blob:", "data:"],
        "img-src": ["blob:", "data:"],
        "font-src": ["blob:", "data:"],
        "media-src": ["blob:", "data:"],
        "frame-src": ["'none'"],
        "worker-src": ["'none'"],
        "connect-src": ["'none'"],
        "object-src": ["'none'"],
        "form-action": ["'none'"],
        "base-uri": ["'none'"]
      }
    }
  }
}
