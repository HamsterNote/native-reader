{
  "name": "@hamster-note/native-reader",
  "version": "0.1.0",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "./src/index.native.ts",
  "browser": "./src/index.web.ts",
  "files": [
    "lib",
    "src",
    "!src/**/*.test.*",
    "!src/**/__tests__/**"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "browser": "./src/index.web.ts",
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bob build",
    "build:clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && bob build",
    "build:verify": "pnpm run build:clean && pnpm run test:consumer && pnpm run test:package",
    "test:consumer": "pnpm exec tsc --project consumer-test/tsconfig.json",
    "test:package": "node scripts/verify-packed-package.mjs",
    "typecheck": "pnpm exec tsc --project tsconfig.json",
    "lint": "pnpm exec eslint . --no-error-on-unmatched-pattern",
    "test": "pnpm exec jest --config ../../jest.config.cjs --rootDir ."
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "0.43.1",
    "react-native-web": "~0.21.0",
    "react-test-renderer": "19.2.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/{__tests__}/**,**/*.test.*}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
