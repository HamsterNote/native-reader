  "directions": {
    "native-to-host": [
      "bind",
      "navigate",
      "flow",
      "dispose"
    ],
    "host-to-native": [
      "ack",
      "error",
      "model",
      "location"
    ]
  },
  "commandRules": {
    "bind": "First command must be bind with an unused random commandId; bridge-bound means only private bridge binding",
    "subsequent": "Unordered random IDs; retain all accepted IDs (maximum 4096 per binding, then terminal); at most one non-dispose command is inflight; never evict IDs",
    "correlation": "host ack, error, model, and location use the same commandId as their command",
    "staleOrDuplicate": "no-op",
    "currentSchemaOrSequenceFailure": "terminal",
    "dispose": "terminal after its ack/error; no ready, source, transfer, URI, base64, bytes, or chunk capability exists"
  },
